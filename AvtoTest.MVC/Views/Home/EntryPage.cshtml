@{
    Layout = "_Layout";
}

<link rel="stylesheet"
      href="~/css/entry.css"
      asp-append-version="true" />


<main class="hero">

    <div class="hero-content">

        <!-- Logo -->

        <div class="hero-logo">

            <span class="hero-logo-icon">
                AT
            </span>

            <span class="hero-logo-text">
                AvtoTest<span>.MVC</span>
            </span>

        </div>


        <!-- Badge -->

        <span class="hero-badge">

            <span class="badge-dot"></span>

            2026 YHQ savollari

        </span>


        <!-- Title -->

        <h1>
            Avto test — Prava test va YHQ testlar 2026
        </h1>


        <!-- Description -->

        <p>
            YHQ testlari, yo'l belgilari va 63 variant —
            haydovchilik guvohnomasi imtihoniga
            bepul onlayn tayyorgarlik
        </p>


        <!-- Buttons -->

        <div class="button-row">

            <a class="start-button start-button--primary"
               asp-controller="Test"
               asp-action="Tickets">

                ▶ Testni boshlash

            </a>


            @if (User.Identity is not null &&
                 User.Identity.IsAuthenticated &&
                 User.IsInRole("Admin"))
            {
                <a class="start-button start-button--admin"
                   asp-controller="Admin"
                   asp-action="CreateTest">

                    + Test qo'shish

                </a>
            }

        </div>


        <!-- Footer -->

        <div class="hero-footer">

            © 2026 AvtoTest.MVC — Barcha huquqlar himoyalangan

        </div>

    </div>

</main>