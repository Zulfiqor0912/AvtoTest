@{
    Layout = "_Layout";
}

<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>E-AVTOMAKTAB</title>

    <link rel="stylesheet" href="~/css/entry.css" asp-append-version="true">
</head>
<body>

    <main class="hero">

        <div class="hero-content">

            <h1>Avto Test</h1>

            <p>Bilimingizni sinang</p>

            <div class="button-row">
                <a class="start-button" asp-controller="Test" asp-action="Tickets">
                    TESTNI BOSHLASH
                </a>

                @if (User.Identity is not null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                {
                    <a class="start-button admin-button" asp-controller="Test" asp-action="CreateTest">
                        YANGI TEST QO'SHISH
                    </a>
                }
            </div>

        </div>

        <div class="hero-image">
            <img src="~/images/testentry.png"
                 alt="E-Avtomaktab">
        </div>

    </main>

</body>
</html>