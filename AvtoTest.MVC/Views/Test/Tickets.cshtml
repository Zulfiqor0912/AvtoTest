@{
    ViewData["Title"] = "Avtotest Chiptalari";
}

<link rel="stylesheet" href="~/css/tickets.css" asp-append-version="true" />

<div class="tickets-page">
    <div class="page-header">
        <div class="header-badge">🚗</div>
        <h1 class="page-title">Avtotest Chiptalari</h1>
        <p class="page-subtitle">Chiptani tanlang va testni boshlang</p>
        <div class="header-stats">
            <span class="stat-item">📋 Jami: 35 ta chipta</span>
            <span class="stat-item">⏱️ Har bir test: 20 daqiqa</span>
            <span class="stat-item">✅ 20/30 ball - O'tish</span>
        </div>
    </div>

    <form asp-action="Tickets" method="post" class="tickets-grid">
        @for (var i = 1; i < 36; i++)
        {
            <div class="flip-card">
                <div class="flip-card-inner">
                    <!-- FRONT -->
                    <div class="flip-card-front">
                        <div class="card-header-badge">
                            <span class="badge-number">#@i</span>
                            <span class="badge-type">Avtotest</span>
                        </div>
                        <img src="https://thumb.ac-illust.com/90/907d84e1baaf57ebdfefcb0a86dfefb1_w.jpeg"
                             alt="Ticket @i"
                             loading="lazy" />
                        <div class="card-content">
                            <div class="ticket-badge">🎯 Chipta @i</div>
                            <h4>20 ta savol</h4>
                            <div class="ticket-info">
                                <span class="ticket-difficulty">
                                    @if (i <= 10)
                                    {
                                        <span class="easy">🟢 Oson</span>
                                    }
                                    else if (i <= 25)
                                    {
                                        <span class="medium">🟡 O'rta</span>
                                    }
                                    else
                                    {
                                        <span class="hard">🔴 Qiyin</span>
                                    }
                                </span>
                                <span class="ticket-time">⏱️ 20 daq</span>
                            </div>
                        </div>
                    </div>

                    <!-- BACK -->
                    <div class="flip-card-back">
                        <div class="back-icon">🚦</div>
                        <h3>Chipta @i</h3>
                        <div class="ticket-number">
                            @if (i <= 10)
                            {
                                <span>🟢 Oson daraja</span>
                            }
                            else if (i <= 25)
                            {
                                <span>🟡 O'rta daraja</span>
                            }
                            else
                            {
                                <span>🔴 Qiyin daraja</span>
                            }
                        </div>
                        <div class="ticket-details">
                            <span>📝 20 ta savol</span>
                            <span>⏱️ 20 daqiqa</span>
                        </div>
                        <button asp-route-id="@i" type="submit" class="btn-go">
                            🚗 Testni boshlash →
                        </button>
                    </div>
                </div>
            </div>
        }
    </form>
</div>