@using AvtoTest.Data.Entities.TestEntities
@model AvtoTest.Data.Entities.TestEntities.Test

@{
    byte ticketId = Convert.ToByte(ViewBag.TicketId);
    HttpContext httpContext = (HttpContext)ViewBag.Context;
    Ticket ticket = ViewBag.Ticket;
    var test = Model;
    List<Test> tests = ViewBag.Tests;
    if (test is null)
    {
        // test = tests[]
    }
}

<link rel="stylesheet" href="~/css/test.css" asp-append-version="true" />

<div class="test-container">
    <!-- HEADER -->
    <div class="test-header">
        <div class="header-left">
            <h1 class="test-title">🚗 Avtotest</h1>
            <div class="ticket-info">
                <span class="ticket-badge">🎫 Chipta #@ticketId</span>
                <span class="question-counter">📝 @(test.Id - ticket.StartIndex + 1) / @(ticket.EndIndex - ticket.StartIndex + 1)</span>
            </div>
        </div>
        <div class="header-right">
            <div class="timer" id="timer">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="12 6 12 12 16 14" />
                </svg>
                <span id="timeDisplay">20:00</span>
            </div>
        </div>
    </div>

    <!-- PROGRESS BAR -->
    <div class="progress-container">
        <div class="progress-bar" id="progressBar" style="width: @((test.Id - ticket.StartIndex + 1) * 100 / (ticket.EndIndex - ticket.StartIndex + 1))%"></div>
    </div>

    <!-- MAIN CONTENT -->
    <div class="test-main">
        <!-- LEFT: QUESTION -->
        <div class="question-section">
            <div class="question-header">
                <span class="question-number">Savol @(test.Id - ticket.StartIndex + 1)</span>
                <div class="language-selector">
                    <a class="lang-btn @(ViewBag.Language == "rus" ? "active" : "")"
                       asp-action="GetTests"
                       asp-route-ticketId="@ticketId"
                       asp-route-testId="@test.Id"
                       asp-route-language="rus">🇷🇺 Rus</a>
                    <a class="lang-btn @(ViewBag.Language == "kiril" ? "active" : "")"
                       asp-action="GetTests"
                       asp-route-ticketId="@ticketId"
                       asp-route-testId="@test.Id"
                       asp-route-language="kiril">🇺🇿 Kiril</a>
                    <a class="lang-btn @(ViewBag.Language == "uzb" ? "active" : "")"
                       asp-action="GetTests"
                       asp-route-ticketId="@ticketId"
                       asp-route-testId="@test.Id"
                       asp-route-language="uzb">🇺🇿 Uzbek</a>
                </div>
            </div>

            <div class="question-content">
                <p class="question-text">@test.Question</p>
            </div>

            <!-- IMAGE -->
            @if (test.Media != null && test.Media.Exist)
            {
                var path = $"{test.Media.Name}.png";
                <div class="question-image">
                    <img src="~/AvtoTest/@path" alt="Test rasmi" />
                </div>
            }
        </div>

        <!-- RIGHT: CHOICES -->
        <div class="choices-section">
            <h3 class="choices-title">⬇️ Javob variantlari</h3>

            <form asp-action="GetTestsPost" method="post" class="choices-form">
                @{
                    int row = 0;
                    string choiceId = httpContext.Request.Cookies[test.Id.ToString()]!;
                    bool isAnswered = !string.IsNullOrEmpty(choiceId);
                }

                @foreach (var choice in test.Choices)
                {
                    string letter = ((char)(65 + row)).ToString();
                    bool isSelected = isAnswered && Convert.ToInt32(choiceId) == row;
                    bool isCorrect = choice.Answer;

                    <button type="submit"
                            class="choice-btn @(isSelected ? (isCorrect ? "correct" : "wrong") : "") @(isAnswered && isCorrect && !isSelected ? "show-correct" : "")"
                            asp-route-ticketId="@ticketId"
                            asp-route-testId="@test.Id"
                            asp-route-choiceId="@row"
                            asp-action="GetTestsPost"
                            disabled="@isAnswered">
                        <span class="choice-letter">@letter</span>
                        <span class="choice-text">@choice.Text</span>
                        @if (isSelected)
                        {
                            <span class="choice-icon">
                                @if (isCorrect)
                                {
                                    <span>✅</span>
                                }
                                else
                                {
                                    <span>❌</span>
                                }
                            </span>
                        }
                        @if (isAnswered && isCorrect && !isSelected)
                        {
                            <span class="choice-icon">✅</span>
                        }
                    </button>

                    row++;
                }
            </form>

            <!-- NAVIGATION BUTTONS -->
            <div class="nav-buttons">
                @{
                    int previousId = test.Id == ticket.StartIndex ? test.Id : test.Id - 1;
                    int nextId = test.Id == ticket.EndIndex ? test.Id : test.Id + 1;
                }

                <a class="nav-btn prev" asp-action="GetTests" asp-route-ticketId="@ticketId" asp-route-testId="@previousId">
                    ← Oldingi
                </a>

                <a class="nav-btn finish" asp-route-ticketId="@ticketId" asp-action="TestResult" onclick="finishTest()">
                    🏁 Testni yakunlash
                </a>

                <a class="nav-btn next" asp-action="GetTests" asp-route-ticketId="@ticketId" asp-route-testId="@nextId">
                    Keyingi →
                </a>
            </div>
        </div>
    </div>

    <!-- PAGINATION -->
    <div class="pagination-section">
        <div class="pagination-wrapper">
            <a class="page-nav" asp-action="GetTests" asp-route-ticketId="@ticketId" asp-route-testId="@previousId">
                ◀
            </a>

            @for (int i = ticket.StartIndex; i <= ticket.EndIndex; i++)
            {
                string choiceIdForPage = httpContext.Request.Cookies[i.ToString()]!;
                string pageClass = "page-link";

                if (test.Id == i)
                {
                    pageClass += " active";
                }
                else if (!string.IsNullOrEmpty(choiceIdForPage))
                {
                    try
                    {
                        int selectedId = Convert.ToInt32(choiceIdForPage);
                        var selectedTest = tests.FirstOrDefault(t => t.Id == i);
                        if (selectedTest != null && selectedTest.Choices != null && selectedTest.Choices.Count > selectedId)
                        {
                            var answer = selectedTest.Choices[selectedId].Answer;
                            pageClass += answer ? " correct" : " wrong";
                        }
                    }
                    catch
                    {
                        // Agar xatolik bo'lsa, hech narsa qilmaymiz
                    }
                }

                <a class="@pageClass" asp-action="GetTests" asp-route-ticketId="@ticket.Id" asp-route-testId="@i">
                    @i
                </a>
            }

            <a class="page-nav" asp-action="GetTests" asp-route-ticketId="@ticketId" asp-route-testId="@nextId">
                ▶
            </a>
        </div>

        <div class="pagination-stats">
            <span class="stat-correct">✅ To'g'ri: <span id="correctCount">0</span></span>
            <span class="stat-wrong">❌ Noto'g'ri: <span id="wrongCount">0</span></span>
            <span class="stat-empty">⬜ Javobsiz: <span id="emptyCount">0</span></span>
        </div>
    </div>
</div>

<!-- ========== JAVASCRIPT ========== -->
<script>
    // Pass ticketId from server to JavaScript
    var ticketId = '@ticketId';
</script>
<script src="~/js/test.js" asp-append-version="true"></script>

<!-- Sahifa yuklangandan keyin statistikani yangilaymiz -->
<script>
    // Sahifa to'liq yuklangandan keyin
    document.addEventListener('DOMContentLoaded', function () {
        // Statistikani hisoblaymiz
        if (typeof updateStats === 'function') {
            setTimeout(updateStats, 300);
        }

        // Har bir javob tanlanganda statistikani yangilaymiz
        const choiceBtns = document.querySelectorAll('.choice-btn');
        choiceBtns.forEach(function (btn) {
            btn.addEventListener('click', function () {
                setTimeout(function () {
                    if (typeof updateStats === 'function') {
                        updateStats();
                    }
                }, 500);
            });
        });
    });
</script>