<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - AvtoTest.MVC</title>

    <script type="importmap"></script>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Custom CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/AvtoTest.MVC.styles.css"
          asp-append-version="true" />
</head>

<body>

    <!-- ================= NAVBAR ================= -->

    <header>
        <nav class="navbar navbar-expand-sm">

            <div class="container-fluid">

                <div class="navbar-content">

                    <!-- Logo -->

                    <a class="navbar-brand"
                       asp-area=""
                       asp-controller="Home"
                       asp-action="Index">

                        AvtoTest

                    </a>


                    <!-- Menu -->

                    <ul class="navbar-nav">

                        @*
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">

                                Home

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Test"
                               asp-action="Tickets">

                                Tickets

                            </a>

                        </li>
                        *@

                    </ul>


                    <!-- Login / Logout -->

                    <div class="navbar-account">

                        <partial name="_LoginPartial" />

                    </div>

                </div>

            </div>

        </nav>
    </header>


    <!-- ================= CONTENT ================= -->

    <main role="main">

        @RenderBody()

    </main>


    <!-- ================= SCRIPTS ================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>