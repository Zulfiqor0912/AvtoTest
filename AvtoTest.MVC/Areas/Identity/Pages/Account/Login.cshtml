@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<!-- Google Font - Inter -->
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<!-- CSS faylni ulash -->
<link rel="stylesheet" href="~/css/login.css" />

<!-- ======================================== -->
<!-- LOGIN WRAPPER - GLASS CARD -->
<!-- ======================================== -->
<div class="login-wrapper">
    <!-- LEFT PANEL - BRANDING -->
    <div class="brand-panel">
        <div class="brand-header">
            <div class="logo-icon">AT</div>
            <div class="logo-text">AvtoTest<span>.MVC</span></div>
        </div>

        <div class="brand-content">
            <div class="badge">✦ Welcome back</div>
            <h1>Sign in to<br />your account</h1>
            <p>Access your dashboard and manage your tasks efficiently.</p>
            <div class="brand-features">
                <div class="feature">
                    <span class="check">✓</span> Secure & encrypted connection
                </div>
                <div class="feature">
                    <span class="check">✓</span> Fast & responsive interface
                </div>
                <div class="feature">
                    <span class="check">✓</span> Access anywhere, anytime
                </div>
            </div>
        </div>

        <div class="brand-footer">
            © 2026 AvtoTest.MVC — All rights reserved
        </div>
    </div>

    <!-- RIGHT PANEL - FORM -->
    <div class="form-panel">
        <div class="form-header">
            <h2>Log in</h2>
            <p>Enter your credentials to access your account</p>
        </div>

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

            <!-- Email -->
            <div class="field-group">
                <label asp-for="Input.Email" class="field-label">Email address</label>
                <div class="input-shell">
                    <svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6z" />
                        <path d="m2 6 10 7 10-7" />
                    </svg>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="you@example.com" />
                </div>
                <span asp-validation-for="Input.Email" class="text-danger field-validation-error"></span>
            </div>

            <!-- Password -->
            <div class="field-group">
                <label asp-for="Input.Password" class="field-label">Password</label>
                <div class="input-shell">
                    <svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" />
                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                    </svg>
                    <input asp-for="Input.Password" id="password-input" class="form-control" autocomplete="current-password" aria-required="true" placeholder="••••••••" />
                    <button type="button" class="pw-toggle" id="pw-toggle" aria-label="Show password">
                        <svg class="icon-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z" />
                            <circle cx="12" cy="12" r="3" />
                        </svg>
                        <svg class="icon-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17.94 17.94A10.94 10.94 0 0 1 12 19c-7 0-11-7-11-7a21.6 21.6 0 0 1 5.06-6.06M9.9 4.24A10.4 10.4 0 0 1 12 4c7 0 11 7 11 7a21.6 21.6 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" />
                            <path d="M1 1l22 22" />
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="Input.Password" class="text-danger field-validation-error"></span>
            </div>

            <!-- Remember Me & Forgot Password -->
            <div class="remember-me">
                <div class="checkbox">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    <label asp-for="Input.RememberMe">@Html.DisplayNameFor(m => m.Input.RememberMe)</label>
                </div>
                <a id="forgot-password" asp-page="./ForgotPassword" class="forgot-link">Forgot password?</a>
            </div>

            <!-- Login Button -->
            <button id="login-submit" type="submit" class="btn-login">
                Log in
                <svg class="arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14" />
                    <path d="m12 5 7 7-7 7" />
                </svg>
            </button>

            <!-- Auth Links -->
            <div class="auth-links">
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">
                    <span class="icon">✨</span> Don't have an account? <strong>Register</strong>
                </a>
                <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">
                    <span class="icon">📧</span> Resend email confirmation
                </a>
            </div>
        </form>

        <!-- Divider -->
        <div class="divider">
            <span>Or continue with</span>
        </div>

        <!-- External Logins -->
        <div>
            @if ((Model.ExternalLogins?.Count ?? 0) == 0)
            {
                <div class="no-external">
                    No external authentication services configured.
                    <a href="https://go.microsoft.com/fwlink/?LinkID=532715">Learn more</a>
                </div>
            }
            else
            {
                <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div class="external-providers">
                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            <button type="submit" class="btn-external" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">
                                @provider.DisplayName
                            </button>
                        }
                    </div>
                </form>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Parolni ko'rsatish / yashirish
        (function() {
            var toggle = document.getElementById('pw-toggle');
            var input = document.getElementById('password-input');
            if (!toggle || !input) return;

            toggle.addEventListener('click', function() {
                var isVisible = input.type === 'text';
                input.type = isVisible ? 'password' : 'text';
                toggle.classList.toggle('is-visible', !isVisible);
                toggle.setAttribute('aria-label', isVisible ? 'Show password' : 'Hide password');
            });
        })();
    </script>
}
