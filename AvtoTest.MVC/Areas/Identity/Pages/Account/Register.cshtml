@page
@model RegisterModel

@{
    ViewData["Title"] = "Register";
}

<!-- Google Font - Inter -->
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<!-- CSS faylni ulash -->
<link rel="stylesheet" href="~/css/register.css" />

<!-- ======================================== -->
<!-- REGISTER WRAPPER - GLASS CARD -->
<!-- ======================================== -->
<div class="register-wrapper">
    <!-- LEFT PANEL - BRANDING -->
    <div class="brand-panel">
        <div class="brand-header">
            <div class="logo-icon">AT</div>
            <div class="logo-text">AvtoTest<span>.MVC</span></div>
        </div>

        <div class="brand-content">
            <div class="badge">✦ Join us</div>
            <h1>Create your<br />account today</h1>
            <p>Start managing your tasks and boost your productivity with AvtoTest.</p>
            <div class="brand-features">
                <div class="feature">
                    <span class="check">✓</span> Free forever
                </div>
                <div class="feature">
                    <span class="check">✓</span> Secure & reliable
                </div>
                <div class="feature">
                    <span class="check">✓</span> 24/7 support
                </div>
            </div>
        </div>

        <div class="brand-footer">
            © 2026 AvtoTest.MVC — All rights reserved
        </div>
    </div>

    <!-- RIGHT PANEL - FORM -->
    <div class="form-panel">
        <div class="form-header">
            <h2>Get started</h2>
            <p>Fill in the details below to create your account</p>
        </div>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

            <!-- Email -->
            <div class="field-group">
                <label asp-for="Input.Email" class="field-label">Email address</label>
                <div class="input-shell">
                    <svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6z" />
                        <path d="m2 6 10 7 10-7" />
                    </svg>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="you@example.com" />
                </div>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <!-- Password -->
            <div class="field-group">
                <label asp-for="Input.Password" class="field-label">Password</label>
                <div class="input-shell">
                    <svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" />
                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                    </svg>
                    <input asp-for="Input.Password" id="password-input" class="form-control" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
                    <button type="button" class="pw-toggle" data-target="password-input" aria-label="Show password">
                        <svg class="icon-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z" />
                            <circle cx="12" cy="12" r="3" />
                        </svg>
                        <svg class="icon-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17.94 17.94A10.94 10.94 0 0 1 12 19c-7 0-11-7-11-7a21.6 21.6 0 0 1 5.06-6.06M9.9 4.24A10.4 10.4 0 0 1 12 4c7 0 11 7 11 7a21.6 21.6 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" />
                            <path d="M1 1l22 22" />
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
                <div class="password-strength" id="pw-strength">
                    <span class="bar"></span><span class="bar"></span><span class="bar"></span>
                </div>
                <span class="password-hint">Must be at least 6 characters</span>
            </div>

            <!-- Confirm Password -->
            <div class="field-group">
                <label asp-for="Input.ConfirmPassword" class="field-label">Confirm password</label>
                <div class="input-shell">
                    <svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" />
                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                    </svg>
                    <input asp-for="Input.ConfirmPassword" id="confirm-password-input" class="form-control" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
                    <button type="button" class="pw-toggle" data-target="confirm-password-input" aria-label="Show password">
                        <svg class="icon-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z" />
                            <circle cx="12" cy="12" r="3" />
                        </svg>
                        <svg class="icon-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17.94 17.94A10.94 10.94 0 0 1 12 19c-7 0-11-7-11-7a21.6 21.6 0 0 1 5.06-6.06M9.9 4.24A10.4 10.4 0 0 1 12 4c7 0 11 7 11 7a21.6 21.6 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" />
                            <path d="M1 1l22 22" />
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <!-- Register Button -->
            <button id="registerSubmit" type="submit" class="btn-register">
                Create account
                <svg class="arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14" />
                    <path d="m12 5 7 7-7 7" />
                </svg>
            </button>

            <!-- Auth Links -->
            <div class="auth-links">
                <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">
                    <span class="icon">🔑</span> Already have an account? <strong>Log in</strong>
                </a>
                <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">
                    <span class="icon">📧</span> Resend email confirmation
                </a>
            </div>
        </form>

        <!-- Divider -->
        <div class="divider">
            <span>Or continue with</span>
        </div>

        <!-- External Logins -->
        <div>
            @if ((Model.ExternalLogins?.Count ?? 0) == 0)
            {
                <div class="no-external">
                    No external authentication services configured.
                    <a href="https://go.microsoft.com/fwlink/?LinkID=532715">Learn more</a>
                </div>
            }
            else
            {
                <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div class="external-providers">
                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            <button type="submit" class="btn-external" name="provider" value="@provider.Name" title="Register using your @provider.DisplayName account">
                                @provider.DisplayName
                            </button>
                        }
                    </div>
                </form>
            }
        </div>

        <div class="register-footer">
            &copy; 2026 AvtoTest.MVC — <a href="#">Privacy Policy</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Parolni ko'rsatish / yashirish (har ikkala maydon uchun)
        (function() {
            document.querySelectorAll('.pw-toggle').forEach(function(toggle) {
                var input = document.getElementById(toggle.getAttribute('data-target'));
                if (!input) return;
                toggle.addEventListener('click', function() {
                    var isVisible = input.type === 'text';
                    input.type = isVisible ? 'password' : 'text';
                    toggle.classList.toggle('is-visible', !isVisible);
                    toggle.setAttribute('aria-label', isVisible ? 'Show password' : 'Hide password');
                });
            });
        })();

        // Parol kuchini ko'rsatish
        (function() {
            var pwInput = document.getElementById('password-input');
            var strength = document.getElementById('pw-strength');
            if (!pwInput || !strength) return;

            pwInput.addEventListener('input', function() {
                var val = pwInput.value;
                strength.classList.remove('weak', 'medium', 'strong');
                if (!val) return;

                var score = 0;
                if (val.length >= 6) score++;
                if (val.length >= 10 && /[A-Z]/.test(val) && /[0-9]/.test(val)) score++;
                if (val.length >= 10 && /[^A-Za-z0-9]/.test(val)) score++;

                if (score <= 1) strength.classList.add('weak');
                else if (score === 2) strength.classList.add('medium');
                else strength.classList.add('strong');
            });
        })();
    </script>
}
